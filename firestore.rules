rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contrataciones/{contractId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.hostName is string
        && request.resource.data.phone is string
        && request.resource.data.eventType is string
        && request.resource.data.date is string
        && request.resource.data.location is string
        && request.resource.data.services is list
        && request.resource.data.services.size() > 0
        && request.resource.data.accepted == true
        && request.resource.data.status == 'confirmada'
        && request.resource.data.total is number
        && request.resource.data.deposit is number
        && request.resource.data.balance is number;
      allow read, update, delete: if false;
    }
  }
}
